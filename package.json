{
  "name": "create-mic-app",
  "version": "1.0.0",
  "description": "Standard Next.js stack boilerplate (App Router, Tailwind, shadcn/ui, Firebase Auth, Drizzle + Supabase, Zod, Vitest, Playwright).",
  "private": true,
  "bin": {
    "create-mic-app": "./bin/cli.js"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "drizzle:generate": "drizzle-kit generate",
    "prepare": "husky install"
  },
  "keywords": [
    "nextjs",
    "tailwind",
    "shadcn",
    "firebase",
    "drizzle",
    "supabase",
    "zod",
    "vitest",
    "playwright"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@radix-ui/react-dialog": "^1.1.1",
    "autoprefixer": "^10.4.20",
    "chalk": "^5.3.0",
    "clsx": "^2.1.1",
    "commander": "^12.1.0",
    "fs-extra": "^11.2.0",
    "firebase": "^10.12.5",
    "firebase-admin": "^12.5.0",
    "lucide-react": "^0.453.0",
    "next": "14.2.5",
    "postcss": "^8.4.41",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "^7.52.1",
    "sonner": "^1.5.0",
    "tailwind-merge": "^2.5.2",
    "tailwindcss": "^3.4.10",
    "zod": "^3.23.8",
    "drizzle-orm": "^0.33.0",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.46.0",
    "@types/node": "^20.14.9",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "drizzle-kit": "^0.25.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.5",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.7",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  }
}
